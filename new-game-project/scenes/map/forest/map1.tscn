[sub_resource type="GDScript" id="GDScript_lgw5x"]
script/source = "extends Node2D

# --- TAMBAHKAN REFERENSI INI DI ATAS ---
# Mendapatkan referensi ke node Hud dan Stage (TileMap)
# Pastikan nama node ini sama persis dengan yang ada di scene tree Anda
@onready var hud = $Hud
@onready var stage_tilemap = $Stage
# --------------------------------------

var knight_scene = preload(\"res://scenes/player/player.tscn\")
var current_player = knight_scene

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Bgm.play_music_forest()
	
	# --- TAMBAHKAN INI UNTUK MENGGAMBAR PETA DI MINIMAP ---
	# Sebelum spawn player, kita perintahkan HUD untuk menyiapkan peta
	if hud and stage_tilemap:
		hud.setup_minimap(stage_tilemap)
	else:
		print(\"ERROR: Node 'Hud' atau 'Stage' tidak ditemukan di game.gd!\")
	# ----------------------------------------------------
	
	spawn_character(current_player)
	
func remove_existing_players():
	for child in get_children():
		print(child)
		if child is CharacterBody2D:
			child.queue_free()

func spawn_character(character_scene: PackedScene):
	var player = character_scene.instantiate()
	player.global_position = Vector2(100, 200)
	player.scale = Vector2(2, 2)
	current_player = player
	add_child(player)
	player.add_to_group(\"player\")
	
	# --- TAMBAHKAN INI UNTUK MENGHUBUNGKAN PLAYER KE HUD ---
	# Tepat setelah player di-add_child, kita kirim referensinya ke HUD
	if hud:
		hud.set_player_node(player)
	else:
		print(\"ERROR: Node 'Hud' tidak ditemukan saat mencoba set_player_node!\")
	# ---------------------------------------------------
"

