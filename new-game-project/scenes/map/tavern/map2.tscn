[sub_resource type="GDScript" id="GDScript_lgw5x"]
script/source = "extends Node2D

const player = preload(\"res://scenes/player/player.tscn\")
const player1 = preload(\"res://scenes/player/player1.tscn\")
const player2 = preload(\"res://scenes/player/player2.tscn\")

func _ready() -> void:
	Bgm.play_music_tavern()
	if(GlobalVar.hero_kontol == 1):
		spawn_character(player)
	elif(GlobalVar.hero_kontol == 2):
		spawn_character(player1)
	elif(GlobalVar.hero_kontol == 3):
		spawn_character(player2)

func remove_existing_players():
	for child in get_children():
		print(child)
		if child is CharacterBody2D:
			child.queue_free()

func spawn_character(character_scene: PackedScene):
	var player = character_scene.instantiate()
	player.global_position = Vector2(192, 200)
	player.scale = Vector2(2, 2)
	add_child(player)
	player.add_to_group(\"player\")
"

