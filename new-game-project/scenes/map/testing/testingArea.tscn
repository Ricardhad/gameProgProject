[sub_resource type="GDScript" id="GDScript_lgw5x"]
script/source = "extends Node2D

var knight_scene = preload(\"res://scenes/player/player.tscn\")

var current_player = knight_scene

@export var hell_hound_boss: Node
@export var boss_health_bar: Control # Remember to drag/drop the nodes in the Inspector

func _ready() -> void:
	Bgm.play_music_forest()
	spawn_character(current_player)
	if not hell_hound_boss or not boss_health_bar:
		printerr(\"Boss or Health Bar not assigned in the Inspector!\")
		return
	
	# Get the Health component from the boss
	var health_component = hell_hound_boss.get_node(\"Health\")
	if not health_component:
		printerr(\"Health component not found on boss!\")
		return

	# --- NEW CONNECTION LOGIC ---

	# 1. INITIALIZE THE BAR
	# Give the health bar the starting values from the boss.
	boss_health_bar.initialize(health_component.max_health, health_component.health)

	# 2. CONNECT THE SIGNALS
	# Connect the signal that fires when health changes.
	health_component.health_changed.connect(boss_health_bar.on_health_changed)
	
	# (Bonus) Connect the signal that fires when MAX health changes.
	# This way, the bar will update correctly if the boss enters a new phase
	# with more or less maximum health.
	health_component.max_health_changed.connect(boss_health_bar.on_max_health_changed)

func remove_existing_players():
	for child in get_children():
		print(child)
		if child is CharacterBody2D:
			child.queue_free()

func spawn_character(character_scene: PackedScene):
	var player = character_scene.instantiate()
	player.global_position = Vector2(100, 200)
	player.scale = Vector2(2, 2)
	current_player = player
	add_child(player)
	player.add_to_group(\"player\")
"

