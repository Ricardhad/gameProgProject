[sub_resource type="GDScript" id="GDScript_xck3o"]
script/source = "extends Node2D

var knight_scene = preload(\"res://scenes/player/player.tscn\")
#var ninja_scene = preload(\"res://Ninja.tscn\")

var current_player = knight_scene
# In your Map's script (e.g., map.gd)
#const pause_menu_scene_path = \"res://scenes/map/GUI/PauseMenu.tscn\"
#var PauseMenuScene = preload(pause_menu_scene_path) 
#var pause_menu_instance: Node2D = null 

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Bgm.play_music_grassland()
	spawn_character(current_player)
	#if PauseMenuScene:
		#pause_menu_instance = PauseMenuScene.instantiate()
		#Node2D.add_child(pause_menu_instance)
		# You might need to hide it initially here, if your scene doesn't do it
		#pause_menu_instance.visible = false
	# You would also connect signals here if you did it this way,
	# but connecting in the editor is easier for persistent UI.
	# E.g., pause_menu_instance.connect(\"resume_game\", self.on_resume_game)
	#else:
		#print(\"Error: Pause Menu scene not found at path: \", pause_menu_scene_path)
	#var slider = $CanvasLayer/PanelPause/PanelPauseOption/HSlider
	#slider.min_value = 0.0
	#slider.max_value = 1.0
	#slider.step = 0.01
	#slider.value = db_to_linear(Bgm.volume_db)


	
func remove_existing_players():
	for child in get_children():
		print(child)
		if child is CharacterBody2D:
			child.queue_free()

func spawn_character(character_scene: PackedScene):
	var player = character_scene.instantiate()
	player.global_position = Vector2(100, 200)
	player.scale = Vector2(2, 2)
	current_player = player
	add_child(player)
	player.add_to_group(\"player\")
	#if current_player:
		#current_player.queue_free()
	#
	#current_player = character_scene.instantiate()
	#current_player.global_position = Vector2(100, 100)
	#add_child(current_player)
"

